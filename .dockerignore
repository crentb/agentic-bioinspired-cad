# Keep the build context (and image) small and reproducible.
# (Comments must be on their own lines; .dockerignore has no inline comments.)
.git
.github
# Documentation PDFs, figures and QMS records: not needed at run time
docs/
# Run outputs (also gitignored)
out/
# Conda lockfiles describe the heavy host-side CAD/FEA environments, not this image
env/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
build/
dist/
.venv/
venv/
.DS_Store
